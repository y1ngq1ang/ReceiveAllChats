<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- SPT 5.0 is IL2CPP only: the client plugin is a BepInEx 6 plugin running on the
         game's .NET 10 runtime and referencing the generated interop assemblies. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ReceiveAllChats</RootNamespace>
    <Nullable>disable</Nullable>
    <Authors>maschine</Authors>
    <Company>https://github.com/maschine34675/ReceiveAllChats</Company>
    <!-- Deliberate deviation from the maschine-<Name>.Client.dll convention: this
         assembly name shipped with 1.0.4 and renaming it would leave the old DLL
         behind in existing installs (double-load). Rename only with a migration note. -->
    <AssemblyName>maschine-ReceiveAllChats</AssemblyName>
    <AssemblyVersion>3.0.2</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Version>$(AssemblyVersion)</Version>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Root of the SPT 5.0 install. Override on the command line when the game
         lives somewhere else: dotnet build -p:SptRoot=D:\SPT -->
    <SptRoot Condition="'$(SptRoot)' == ''">C:\SPT-5.0-BE</SptRoot>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReceiveAllChats.Shared\ReceiveAllChatsProtocol.cs" Link="ReceiveAllChatsProtocol.cs" />
  </ItemGroup>

  <ItemGroup Label="BepInEx 6 (IL2CPP)">
    <Reference Include="0Harmony">
      <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(SptRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTushonka.Reflection">
      <HintPath>$(SptRoot)\BepInEx\plugins\sptushonka\SPTushonka.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="Interop assemblies (generated by BepInEx on first launch)">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptRoot)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CoreServices">
      <HintPath>$(SptRoot)\BepInEx\interop\CoreServices.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptRoot)\BepInEx\interop\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Diz.Binding">
      <HintPath>$(SptRoot)\BepInEx\interop\Diz.Binding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Diz.Jobs">
      <HintPath>$(SptRoot)\BepInEx\interop\Diz.Jobs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptRoot)\BepInEx\interop\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(SptRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployOnBuild)' != 'false'">
    <Exec Command="copy &quot;$(TargetPath)&quot; &quot;$(SptRoot)\BepInEx\plugins\$(TargetFileName)&quot;" />
  </Target>

</Project>
