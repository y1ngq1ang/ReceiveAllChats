<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ReceiveAllChats.Server</RootNamespace>
    <AssemblyName>maschine-ReceiveAllChats.Server</AssemblyName>
    <Authors>maschine</Authors>
    <Company>https://github.com/maschine34675/ReceiveAllChats</Company>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>3.0.2</Version>
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SptModName>ReceiveAllChats</SptModName>
    <!-- SPT 5.0 is not on NuGet yet, so the server mod compiles against the assemblies
         shipped with the install. Override with -p:SptRoot=D:\SPT when needed. -->
    <SptRoot Condition="'$(SptRoot)' == ''">C:\SPT-5.0-BE</SptRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReceiveAllChats.Shared\ReceiveAllChatsProtocol.cs" Link="ReceiveAllChatsProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SptRoot)\SPT_Runtime\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptRoot)\SPT_Runtime\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployOnBuild)' != 'false'">
    <Exec Command="if not exist &quot;$(SptRoot)\SPT_Runtime\user\mods\$(SptModName)&quot; mkdir &quot;$(SptRoot)\SPT_Runtime\user\mods\$(SptModName)&quot;&#xD;&#xA;copy &quot;$(TargetPath)&quot; &quot;$(SptRoot)\SPT_Runtime\user\mods\$(SptModName)\$(TargetFileName)&quot;" />
  </Target>

</Project>
