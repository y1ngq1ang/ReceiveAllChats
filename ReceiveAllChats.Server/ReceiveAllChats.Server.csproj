<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ReceiveAllChats.Server</RootNamespace>
    <AssemblyName>maschine-ReceiveAllChats.Server</AssemblyName>
    <Authors>maschine</Authors>
    <Company>https://github.com/maschine34675/ReceiveAllChats</Company>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.0.0</Version>
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SptModName>ReceiveAllChats</SptModName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ReceiveAllChats.Shared\ReceiveAllChatsProtocol.cs" Link="ReceiveAllChatsProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployOnBuild)' != 'false'">
    <Exec Command="if not exist &quot;$(ProjectDir)..\..\..\SPT_Runtime\user\mods\$(SptModName)&quot; mkdir &quot;$(ProjectDir)..\..\..\SPT_Runtime\user\mods\$(SptModName)&quot;&#xD;&#xA;copy &quot;$(TargetPath)&quot; &quot;$(ProjectDir)..\..\..\SPT_Runtime\user\mods\$(SptModName)\$(TargetFileName)&quot;" />
  </Target>

</Project>
